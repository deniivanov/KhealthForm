# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (include the database name in the path).
MONGODB_URI=mongodb+srv://user:password@host/khealth

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Initial admin account, used ONLY by `npm run seed` to create the first
# User document (login itself checks the users collection, not these vars).
# ADMIN_PASSWORD_HASH is a bcrypt hash. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
# IMPORTANT: in .env files, escape every $ in the hash as \$ — Next.js
# expands $VAR references otherwise and silently corrupts the value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ── ImageKit (image uploads from the admin) ─────────────────────────────────
# Private API key from https://imagekit.io/dashboard/developer/api-keys
# Uploads are proxied through /api/admin/upload — the key stays server-side.
# Without it, the upload buttons show a clear error; pasting URLs still works.
IMAGEKIT_PRIVATE_KEY=
# Optional target folder in the ImageKit media library (default /khealth)
#IMAGEKIT_UPLOAD_FOLDER=/khealth

# ── Integrations (optional) ─────────────────────────────────────────────────
# If set, new orders are POSTed server-side to this n8n webhook after being
# saved to Mongo. Leave unset if the n8n flow itself writes to Mongo,
# otherwise orders will be duplicated. (Legacy flow; removed at cutover.)
#N8N_WEBHOOK_URL=
